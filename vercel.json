{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/proyek/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.cjs": {
      "includeFiles": ["effects/**", "effect-index.json"],
      "maxDuration": 60
    }
  }
}
